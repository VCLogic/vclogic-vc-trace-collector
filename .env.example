# Optional search provider (operator-controlled SearXNG JSON endpoint)
VC_TRACE_SEARCH_ENDPOINT=

# Optional OpenAI-compatible structured discovery provider
VC_TRACE_LLM_ENDPOINT=
VC_TRACE_LLM_API_KEY=
VC_TRACE_DISCOVERY_MODEL=

# Optional Hugging Face access for operator-selected gated AV models
HF_TOKEN=

# Optional device selection consumed by operator integrations, e.g. cpu/cuda/mps
VC_TRACE_AV_DEVICE=

# Explicit opt-in for operator-managed HTTP(S) proxy environment variables
VC_TRACE_ALLOW_ENV_PROXY=
